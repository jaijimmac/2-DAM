+
+'use strict'
+
+/**
+ * Module dependencies.
+ * @private
+ */
+
+var contentType = require('content-type')
+var mime = require('mime-types')
+var typer = require('media-typer')
+
+/**
+ * Module exports.
+ * @public
+ */
+
