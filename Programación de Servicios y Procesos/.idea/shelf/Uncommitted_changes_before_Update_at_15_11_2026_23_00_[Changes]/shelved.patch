+<%- include('partials/cabecera') %>
+<main>
+    <h1><%= titulo %></h1>
+    <table>
+            <thead>
+                <tr>
+                    <th>Título</th>
+                    <th>Autor</th>
+                    <th>Año</th>
+                    <th>Disponible</th>
+                </tr>
+            </thead>
+            <tbody>
+            <tbody>
+                <% if (libros && libros.length > 0) { %>
+                    <% libros.forEach(l => { %>
+                    <tr>
+                        <td><%= l.titulo %></td>
+                        <td><%= l.autor %> <%= (l.anio < 2000) ? '(Clasico)' : '' %></td>
+                        <td><%= l.anio %></td>
+                        <td><%= l.disponible ? 'Disponible' : 'Prestado' %></td> 
+                    </tr>
+                    <% }) %>
+                <% } else { %>
+                    <tr>
+                    <td colspan="2">No hay libros disponibles.</td>
+                    </tr>
+                <% } %>
+    </tbody>
+    </table>
+</main>
+<%- include('partials/pie') %>
